!demo/*_검토후보.xlsx
*_gold.xlsx

# 오프라인 설치용 wheel 번들 (릴리스 자산으로 배포)
wheels/

# 학습된 분류기 (회사 데이터로 학습, 저장소 밖에 둔다)
*.npz

# 회사별 설정과 모델 파일 (저장소 밖 또는 로컬 전용)
